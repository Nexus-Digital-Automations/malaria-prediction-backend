# =============================================================================
# Malaria Prediction System - Development Environment Configuration
# =============================================================================
# Copy this file to .env and customize for your environment:
#   cp .env.development .env
#
# SECURITY WARNING: Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME="Malaria Prediction API"
VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=true
TESTING=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
WORKERS=1

# -----------------------------------------------------------------------------
# Database Configuration (TimescaleDB/PostgreSQL)
# -----------------------------------------------------------------------------
# For Docker: postgresql+asyncpg://postgres:postgres@db:5432/malaria_prediction
# For Local:  postgresql+asyncpg://postgres:postgres@localhost:5432/malaria_prediction
DATABASE__URL=postgresql+asyncpg://postgres:postgres@localhost:5432/malaria_prediction
DATABASE__ECHO=false
DATABASE__POOL_SIZE=20
DATABASE__MAX_OVERFLOW=0
DATABASE__POOL_TIMEOUT=30
DATABASE__POOL_RECYCLE=3600

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# For Docker: redis://redis:6379/0
# For Local:  redis://localhost:6379/0
REDIS__URL=redis://localhost:6379/0
REDIS__MAX_CONNECTIONS=50
REDIS__SOCKET_TIMEOUT=5
REDIS__SOCKET_CONNECT_TIMEOUT=5
REDIS__CELERY_BROKER_DB=1
REDIS__CELERY_RESULT_DB=2

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# IMPORTANT: Generate a unique secret key for production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECURITY__SECRET_KEY=dev-secret-key-change-in-production-abc123
SECURITY__JWT_ALGORITHM=HS256
SECURITY__JWT_EXPIRATION_HOURS=24
SECURITY__PASSWORD_MIN_LENGTH=8
SECURITY__CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:3000"]
SECURITY__CORS_ALLOW_CREDENTIALS=true
SECURITY__RATE_LIMIT_PER_MINUTE=100

# -----------------------------------------------------------------------------
# External API Configuration
# -----------------------------------------------------------------------------
# ERA5 Climate Data (Copernicus Climate Data Store)
# Get your API key at: https://cds.climate.copernicus.eu/
EXTERNAL_APIS__ERA5_API_KEY=
EXTERNAL_APIS__ERA5_API_URL=https://cds.climate.copernicus.eu/api/v2

# CHIRPS Precipitation Data
EXTERNAL_APIS__CHIRPS_API_ENDPOINT=https://data.chc.ucsb.edu/api/

# MODIS/NASA Earth Data
# Get your API key at: https://urs.earthdata.nasa.gov/
EXTERNAL_APIS__MODIS_API_KEY=
EXTERNAL_APIS__MODIS_API_URL=https://modis.gsfc.nasa.gov/data/

# WorldPop Population Data
EXTERNAL_APIS__WORLDPOP_API_ENDPOINT=https://hub.worldpop.org/

# Malaria Atlas Project
EXTERNAL_APIS__MAP_API_ENDPOINT=https://malariaatlas.org/

# API Rate Limiting
EXTERNAL_APIS__MAX_REQUESTS_PER_MINUTE=100
EXTERNAL_APIS__REQUEST_TIMEOUT=30
EXTERNAL_APIS__RETRY_ATTEMPTS=3
EXTERNAL_APIS__RETRY_DELAY=5

# -----------------------------------------------------------------------------
# ML Model Configuration
# -----------------------------------------------------------------------------
ML_MODELS__STORAGE_PATH=./models
ML_MODELS__ENABLE_CACHE=true
ML_MODELS__CACHE_TTL=3600
ML_MODELS__MAX_MEMORY_USAGE=4096
ML_MODELS__DEVICE=auto
ML_MODELS__BATCH_SIZE=32

# -----------------------------------------------------------------------------
# Data Storage Configuration
# -----------------------------------------------------------------------------
DATA__DIRECTORY=./data
DATA__ENABLE_CACHE=true
DATA__CACHE_TTL=1800
DATA__MAX_FILE_SIZE=1073741824
DATA__COMPRESSION_ENABLED=true
DATA__BACKUP_ENABLED=true
DATA__RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# Monitoring Configuration
# -----------------------------------------------------------------------------
MONITORING__PROMETHEUS_ENABLED=true
MONITORING__PROMETHEUS_PORT=9090
MONITORING__HEALTH_CHECK_INTERVAL=30
MONITORING__ENABLE_REQUEST_LOGGING=true
MONITORING__LOG_LEVEL=DEBUG
MONITORING__TRACING_ENABLED=false

# -----------------------------------------------------------------------------
# Firebase Cloud Messaging (Optional - for push notifications)
# -----------------------------------------------------------------------------
# FCM__PROJECT_ID=
# FCM__PRIVATE_KEY_ID=
# FCM__PRIVATE_KEY=
# FCM__CLIENT_EMAIL=
# FCM__CLIENT_ID=
# FCM__TOKEN_URI=https://oauth2.googleapis.com/token

# =============================================================================
# Docker Compose Override (when using docker-compose)
# =============================================================================
# Uncomment these when running with docker-compose:
# DATABASE__URL=postgresql+asyncpg://postgres:postgres@db:5432/malaria_prediction
# REDIS__URL=redis://redis:6379/0
